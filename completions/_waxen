#compdef waxen
# zsh completion for waxen

_waxen() {
    local -a target_options
    target_options=(
        '--details[print the full evidence report]'
        '--verbose[full report plus suggested repair actions]'
        '--share[print the verdict as Markdown for an issue]'
        '--json[emit a machine readable JSON report]'
        '--no-color[disable colored output]'
        '--help[show help]'
        '-h[show help]'
    )

    if (( CURRENT == 2 )); then
        local -a toplevel
        toplevel=(
            'diagnose:explain whether macOS is right to block an app'
            'evidence:show raw evidence for an application, disk image, or installer package'
            'finder:install or remove the Finder Quick Action'
            '--version:print the waxen version'
            '-V:print the waxen version'
            '--help:show help'
            '-h:show help'
        )
        _describe -t commands 'waxen' toplevel
        _files -g "*.app(-/)" -g "*.dmg" -g "*.pkg"
        return
    fi

    case "${words[2]}" in
        diagnose | evidence)
            _arguments \
                '*:application artifact:_files -g "*.app(-/)" -g "*.dmg" -g "*.pkg"' \
                $target_options
            ;;
        finder)
            if (( CURRENT == 3 )); then
                local -a actions
                actions=(
                    'install:add "Why Won'"'"'t This Open?" to Finder'
                    'uninstall:remove the Quick Action'
                )
                _describe -t actions 'finder action' actions
            fi
            ;;
        *)
            _arguments \
                '*:application artifact:_files -g "*.app(-/)" -g "*.dmg" -g "*.pkg"' \
                $target_options
            ;;
    esac
}

_waxen "$@"
